{
  "name": "lost-codex-theme",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local-first visual theme editor for Codex Desktop",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/xiaopenghuang/LostCodexTheme.git" },
  "homepage": "https://github.com/xiaopenghuang/LostCodexTheme",
  "bugs": { "url": "https://github.com/xiaopenghuang/LostCodexTheme/issues" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts/desktop.ps1 dev",
    "desktop:build": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts/desktop.ps1 build",
    "desktop:icons": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts/icons.ps1",
    "test:native": "node scripts/native-smoke.mjs",
    "test:installer": "node scripts/verify-installer.mjs",
    "test:production": "npm run build && playwright test --config playwright.production.config.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "pretest": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts/cargo.ps1 build --example codex_poc",
    "test": "playwright test",
    "test:bridge": "playwright test tests/browser",
    "test:editor": "playwright test tests/editor",
    "test:unit": "playwright test tests/unit"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@tauri-apps/api": "^2.8.0",
    "fflate": "^0.8.2",
    "css-tree": "^3.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.0.0",
    "@types/css-tree": "^2.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
